if __name__ == '__main__':
	from sys import argv
	
	match argv[1]:
		case 'server':
			basename = argv[2]
			interfaces = parse_xml(basename + '.xml')
			server_path = Path(basename + '_server.py')
			with server_path.open('w') as fd:
				generate_server(basename, interfaces, fd)
			server_path.chmod(0o111 | server_path.stat().st_mode)
		
		case _:
			raise ValueError


