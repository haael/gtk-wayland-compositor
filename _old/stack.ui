<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow">
    <property name="child">
      <object class="GtkOverlay" id="bin_layer">
        <property name="child">
          <object class="GtkStack" id="stack_background">
            <child>
              <placeholder/>
            </child>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkBox" id="box_horizontal">
            <property name="valign">center</property>
            <property name="orientation">vertical</property>
            <property name="spacing">30</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="box_vertical">
            <property name="halign">center</property>
            <property name="spacing">30</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="box_top_immovable">
            <property name="valign">start</property>
            <property name="orientation">vertical</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="box_bottom_immovable">
            <property name="valign">end</property>
            <property name="orientation">vertical</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="box_left_immovable">
            <property name="halign">start</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="box_right_immovable">
            <property name="halign">end</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkGrid" id="grid_outer">
            <child>
              <object class="GtkBox" id="box_top_exclusive">
                <property name="valign">start</property>
                <property name="orientation">vertical</property>
                <property name="baseline-position">top</property>
                <child>
                  <placeholder/>
                </child>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="column-span">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="box_bottom_exclusive">
                <property name="valign">end</property>
                <property name="orientation">vertical</property>
                <property name="baseline-position">bottom</property>
                <child>
                  <placeholder/>
                </child>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                  <property name="column-span">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="box_left_exclusive">
                <property name="halign">start</property>
                <child>
                  <placeholder/>
                </child>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="box_right_exclusive">
                <property name="halign">end</property>
                <child>
                  <placeholder/>
                </child>
                <layout>
                  <property name="column">2</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid_inner">
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <child>
                  <object class="GtkBox" id="box_top_movable">
                    <property name="valign">start</property>
                    <property name="orientation">vertical</property>
                    <property name="baseline-position">top</property>
                    <child>
                      <placeholder/>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="column-span">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_bottom_movable">
                    <property name="valign">end</property>
                    <property name="orientation">vertical</property>
                    <property name="baseline-position">bottom</property>
                    <child>
                      <placeholder/>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                      <property name="column-span">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_left_movable">
                    <property name="halign">start</property>
                    <child>
                      <placeholder/>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_right_movable">
                    <property name="halign">end</property>
                    <child>
                      <placeholder/>
                    </child>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFixed" id="corner_top_left">
                    <property name="width-request">0</property>
                    <property name="height-request">0</property>
                    <property name="halign">start</property>
                    <property name="valign">start</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFixed" id="corner_bottom_left">
                    <property name="width-request">0</property>
                    <property name="height-request">0</property>
                    <property name="halign">start</property>
                    <property name="valign">end</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFixed" id="corner_top_right">
                    <property name="width-request">0</property>
                    <property name="height-request">0</property>
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFixed" id="corner_bottom_right">
                    <property name="width-request">0</property>
                    <property name="height-request">0</property>
                    <property name="halign">end</property>
                    <property name="valign">end</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame" id="frame_main">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <child>
                      <placeholder/>
                    </child>
                    <child type="label_item">
                      <placeholder/>
                    </child>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
